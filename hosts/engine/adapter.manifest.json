{
  "host": "engine",
  "version": "1.1.0",
  "display": "Engine",
  "level": "experimental",
  "server_side": "declined",
  "status_label": "Experimental: server side declined (PR #727, 2026-10-29)",
  "note": "jobs per role, channel delivery for the owner pack",
  "state_store": { "backend": "engine", "module": "state-store/index.mjs", "settings_schema": "state-store/settings.schema.json", "conformance": "state-store/conformance.mjs" },
  "calls": {
    "spawn": {
      "input": { "type": "object", "required": ["role", "tier", "brief"] },
      "output": { "type": "object", "required": ["outcome", "result_path"] },
      "outcomes": ["ok", "UNTIERED_SPAWN"]
    },
    "ask": {
      "input": { "type": "object", "required": ["questions"] },
      "output": { "type": "object", "required": ["outcome"] },
      "outcomes": ["ok", "NOT_SUPPORTED"]
    },
    "collect": {
      "input": { "type": "object" },
      "output": { "type": "object", "required": ["results", "partial"] },
      "outcomes": ["ok"]
    },
    "continue": {
      "input": { "type": "object", "required": ["run_id", "path"] },
      "output": { "type": "object", "required": ["outcome"] },
      "outcomes": ["ok", "HANDOFF_FAILED", "NOT_SUPPORTED"]
    },
    "wake": {
      "input": { "type": "object", "required": ["at", "prompt"] },
      "output": { "type": "object", "required": ["outcome"] },
      "outcomes": ["PARKED", "NOT_SUPPORTED"]
    },
    "meter": {
      "input": { "type": "object" },
      "output": { "type": "object" },
      "outcomes": ["ok"]
    }
  },
  "drivers": {
    "isolation": { "methods": ["create", "remove"] },
    "secrets": { "methods": ["use", "redact", "describe"] },
    "stateStore": { "methods": ["get", "put", "append", "list"] }
  }
}
