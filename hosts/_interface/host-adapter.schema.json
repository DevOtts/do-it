{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "do-it HostAdapter manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["host", "version", "calls", "drivers"],
  "properties": {
    "host": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "display": { "type": "string", "minLength": 1 },
    "level": { "enum": ["native", "supported", "experimental"] },
    "server_side": { "enum": ["supported", "declined"] },
    "status_label": { "type": "string", "minLength": 1 },
    "note": { "type": "string" },
    "state_store": {
      "type": "object", "additionalProperties": false,
      "required": ["module"],
      "properties": {
        "backend": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "minLength": 1 },
        "settings_schema": { "type": "string" },
        "conformance": { "type": "string" }
      }
    },
    "skips": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case", "reason"],
        "properties": { "case": { "type": "string", "minLength": 1 }, "reason": { "type": "string" } }
      }
    },
    "calls": {
      "type": "object", "additionalProperties": false,
      "required": ["spawn", "ask", "collect", "continue", "wake", "meter"],
      "properties": {
        "spawn": { "$ref": "#/$defs/call" },
        "ask": { "$ref": "#/$defs/call" },
        "collect": { "$ref": "#/$defs/call" },
        "continue": { "$ref": "#/$defs/call" },
        "wake": { "$ref": "#/$defs/call" },
        "meter": { "$ref": "#/$defs/call" }
      }
    },
    "drivers": {
      "type": "object", "additionalProperties": false,
      "required": ["isolation", "secrets", "stateStore"],
      "properties": {
        "isolation": { "$ref": "#/$defs/driver" },
        "secrets": { "$ref": "#/$defs/driver" },
        "stateStore": { "$ref": "#/$defs/driver" }
      }
    }
  },
  "$defs": {
    "call": {
      "type": "object", "additionalProperties": false,
      "required": ["input", "output", "outcomes"],
      "properties": {
        "input": { "type": "object" },
        "output": { "type": "object" },
        "outcomes": {
          "type": "array", "minItems": 1,
          "items": { "enum": ["ok", "HANDOFF_FAILED", "PARKED", "UNTIERED_SPAWN", "NOT_SUPPORTED", "ESCALATED", "TIER_UNROUTED"] }
        }
      }
    },
    "driver": {
      "type": "object", "additionalProperties": false,
      "required": ["methods"],
      "properties": { "methods": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } }
    }
  }
}
