{
  "version": 1,
  "note": "Field map idea copied from LiteLLM (research/09 section 3). Dotted paths into the provider usage object. A field a shape lacks is null, never 0. Shapes are the documented ones; host CLI output shapes stay unverified until a paid run (docs/research/11 unknown 1).",
  "shapes": [
    {
      "id": "input-output-cache-creation-read",
      "requires": ["input_tokens", "output_tokens", "cache_creation_input_tokens", "cache_read_input_tokens"],
      "fields": { "tokens_in": "input_tokens", "tokens_out": "output_tokens", "cache_read": "cache_read_input_tokens", "cache_write": "cache_creation_input_tokens" }
    },
    {
      "id": "input-cached-output",
      "requires": ["input_tokens", "cached_input_tokens", "output_tokens"],
      "fields": { "tokens_in": "input_tokens", "tokens_out": "output_tokens", "cache_read": "cached_input_tokens", "cache_write": null }
    },
    {
      "id": "nested-tokens-cache",
      "requires": ["tokens.input", "tokens.output", "tokens.cache.read", "tokens.cache.write"],
      "fields": { "tokens_in": "tokens.input", "tokens_out": "tokens.output", "cache_read": "tokens.cache.read", "cache_write": "tokens.cache.write" }
    },
    {
      "id": "prompt-completion",
      "requires": ["prompt_tokens", "completion_tokens"],
      "fields": { "tokens_in": "prompt_tokens", "tokens_out": "completion_tokens", "cache_read": "prompt_tokens_details.cached_tokens", "cache_write": null }
    }
  ]
}
