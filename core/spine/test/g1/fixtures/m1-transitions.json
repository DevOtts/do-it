{
  "note": "One entry per CONTRACT §8 M1 edge (18) plus 6 docs/03 §6 rows, plus M1-25 (A5 carry before any row on the new key). Event DSL: t f=finish s=start x=corrupt line; run = run number; key = key label; res = result; ago = hours before now (default spaced 0.1 h). opts.open = runs without run_end; opts.live = runs whose owner is alive; opts.tainted = runs whose run_end is tainted.",
  "entries": [
    { "id": "M1-01", "edge": "NEVER_RUN --> RUNNING", "events": [{ "t": "s", "run": 1 }], "opts": { "open": [1], "live": [1] }, "expect": { "state": "RUNNING", "reuse": null, "flakyPasses": 0 } },
    { "id": "M1-02", "edge": "RUNNING --> PASS", "events": [{ "t": "s", "run": 1 }, { "t": "f", "run": 1, "res": "PASS" }], "expect": { "state": "PASS", "reuse": "PASS", "flakyPasses": 0 } },
    { "id": "M1-03", "edge": "RUNNING --> FAIL", "events": [{ "t": "f", "run": 1, "res": "FAIL" }], "expect": { "state": "FAIL", "reuse": null, "flakyPasses": 0 } },
    { "id": "M1-04", "edge": "RUNNING --> SKIPPED (PASS then SKIPPED)", "events": [{ "t": "f", "run": 1, "res": "PASS" }, { "t": "f", "run": 2, "res": "SKIPPED" }], "expect": { "state": "SKIPPED", "reuse": "SKIPPED", "flakyPasses": 0 } },
    { "id": "M1-05", "edge": "RUNNING --> FLAKY (retried pass)", "events": [{ "t": "f", "run": 1, "res": "PASS", "retried": true }], "expect": { "state": "FLAKY", "reuse": null, "flakyPasses": 0 } },
    { "id": "M1-06", "edge": "RUNNING --> KILLED (owner dead, no finish)", "events": [{ "t": "s", "run": 1 }], "opts": { "open": [1] }, "expect": { "state": "KILLED", "reuse": null, "flakyPasses": 0, "kills": 1 } },
    { "id": "M1-07", "edge": "KILLED --> NEVER_RUN (resume runs it again)", "events": [{ "t": "s", "run": 1 }], "opts": { "open": [1], "resume": true }, "expect": { "state": "KILLED", "reuse": null, "flakyPasses": 0, "kills": 1 } },
    { "id": "M1-08", "edge": "KILLED --> SUSPECT_KILLER (second kill on one key)", "events": [{ "t": "s", "run": 1 }, { "t": "s", "run": 2 }], "opts": { "open": [1, 2] }, "expect": { "state": "SUSPECT_KILLER", "reuse": null, "flakyPasses": 0, "kills": 2 } },
    { "id": "M1-09", "edge": "PASS --> NEVER_RUN (key changed)", "events": [{ "t": "f", "run": 1, "res": "PASS", "key": "k1" }], "keyNow": "k2", "expect": { "state": "NEVER_RUN", "reuse": null, "flakyPasses": 0, "reason": "invalidated" } },
    { "id": "M1-10", "edge": "PASS --> EXPIRED (TTL)", "events": [{ "t": "f", "run": 1, "res": "PASS", "ago": 25 }], "expect": { "state": "EXPIRED", "reuse": null, "flakyPasses": 0, "reason": "expired" } },
    { "id": "M1-11", "edge": "EXPIRED --> NEVER_RUN (the caller runs it; the next PASS is fresh)", "events": [{ "t": "f", "run": 1, "res": "PASS", "ago": 30 }, { "t": "f", "run": 2, "res": "PASS", "ago": 1 }], "expect": { "state": "PASS", "reuse": "PASS", "flakyPasses": 0 } },
    { "id": "M1-12", "edge": "PASS --> FLAKY (fail on same key)", "events": [{ "t": "f", "run": 1, "res": "PASS" }, { "t": "f", "run": 2, "res": "FAIL" }], "expect": { "state": "FLAKY", "reuse": null, "flakyPasses": 0 } },
    { "id": "M1-13", "edge": "FAIL --> FLAKY (pass on same key)", "events": [{ "t": "f", "run": 1, "res": "FAIL" }, { "t": "f", "run": 2, "res": "PASS" }], "expect": { "state": "FLAKY", "reuse": null, "flakyPasses": 1 } },
    { "id": "M1-14", "edge": "FAIL --> NEVER_RUN (fix changes key)", "events": [{ "t": "f", "run": 1, "res": "FAIL", "key": "k1" }], "keyNow": "k2", "expect": { "state": "NEVER_RUN", "reuse": null, "flakyPasses": 0, "reason": "invalidated" } },
    { "id": "M1-15", "edge": "FLAKY --> PASS (two consecutive passes)", "events": [{ "t": "f", "run": 1, "res": "FAIL" }, { "t": "f", "run": 2, "res": "PASS" }, { "t": "f", "run": 3, "res": "PASS" }], "expect": { "state": "PASS", "reuse": "PASS", "flakyPasses": 0 } },
    { "id": "M1-16", "edge": "PASS --> UNSTABLE_UNDER_REUSE (clean run disagrees)", "events": [{ "t": "f", "run": 1, "res": "PASS", "ago": 5 }, { "t": "f", "run": 2, "res": "FAIL", "clean": true, "ago": 2 }], "expect": { "state": "UNSTABLE_UNDER_REUSE", "reuse": null, "flakyPasses": 0 } },
    { "id": "M1-17", "edge": "UNSTABLE_UNDER_REUSE --> PASS (7 days and two clean passes)", "events": [{ "t": "f", "run": 1, "res": "PASS", "ago": 216 }, { "t": "f", "run": 2, "res": "FAIL", "clean": true, "ago": 192 }, { "t": "f", "run": 3, "res": "PASS", "clean": true, "ago": 3 }, { "t": "f", "run": 4, "res": "PASS", "clean": true, "ago": 1 }], "expect": { "state": "PASS", "reuse": "PASS", "flakyPasses": 0 } },
    { "id": "M1-18", "edge": "CORRUPT --> NEVER_RUN (row ignored)", "events": [{ "t": "x" }, { "t": "f", "run": 2, "res": "PASS" }], "expect": { "state": "PASS", "reuse": "PASS", "flakyPasses": 0 } },
    { "id": "D3-01", "edge": "docs/03: DESELECTED folds as SKIPPED", "events": [{ "t": "f", "run": 1, "res": "DESELECTED" }], "expect": { "state": "SKIPPED", "reuse": "SKIPPED", "flakyPasses": 0 } },
    { "id": "D3-02", "edge": "docs/03: FLAKY then FAIL => FLAKY n 0", "events": [{ "t": "f", "run": 1, "res": "FAIL" }, { "t": "f", "run": 2, "res": "PASS" }, { "t": "f", "run": 3, "res": "FAIL" }], "expect": { "state": "FLAKY", "reuse": null, "flakyPasses": 0 } },
    { "id": "D3-03", "edge": "docs/03: PASS from a tainted run is ignored", "events": [{ "t": "f", "run": 1, "res": "PASS" }], "opts": { "tainted": [1] }, "expect": { "state": "NEVER_RUN", "reuse": null, "flakyPasses": 0, "reason": "tainted-run" } },
    { "id": "D3-04", "edge": "docs/03: clean PASS resets age", "events": [{ "t": "f", "run": 1, "res": "PASS", "ago": 30 }, { "t": "f", "run": 2, "res": "PASS", "clean": true, "ago": 1 }], "expect": { "state": "PASS", "reuse": "PASS", "flakyPasses": 0 } },
    { "id": "D3-05", "edge": "docs/03: PASS-invariant violation by a non-spine writer => FAIL (H1 failed>0, H5 passed 0)", "events": [{ "t": "f", "run": 1, "res": "PASS", "inv": "h5" }], "expect": { "state": "FAIL", "reuse": null, "flakyPasses": 0, "reason": "pass-invariant" } },
    { "id": "D3-06", "edge": "docs/03 (A5): FAIL then clean PASS => FLAKY n 1", "events": [{ "t": "f", "run": 1, "res": "FAIL" }, { "t": "f", "run": 2, "res": "PASS", "clean": true }], "expect": { "state": "FLAKY", "reuse": null, "flakyPasses": 1 } },
    { "id": "M1-25", "edge": "FLAKY carry across a key change before the new key has a row (A5)", "events": [{ "t": "f", "run": 1, "res": "PASS", "key": "k1" }, { "t": "f", "run": 2, "res": "FAIL", "key": "k1" }], "keyNow": "k2", "expect": { "state": "FLAKY", "reuse": null, "flakyPasses": 0, "reason": "flaky-carry" } }
  ]
}
