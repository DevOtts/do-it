{
  "$id": "do-it-gate-result/1",
  "title": "gate results store row (one canonical JSON line of results.jsonl)",
  "type": "object",
  "required": ["schema", "type", "run_id", "at", "crc"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "do-it-gate-result/1" },
    "type": { "enum": ["start", "finish", "run_start", "run_end", "clean"] },
    "run_id": { "type": "string", "pattern": "^g-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$" },
    "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$" },
    "file": { "type": "string", "minLength": 1 },
    "leg": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.:-]+$" },
    "scope": { "enum": ["edit", "push", "train", "nightly"] },
    "key": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gate": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "runner": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "core": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "installed": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "env": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "platform": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "deps": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "class": { "enum": ["NARROW", "WIDE"] },
        "tree": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "result": { "enum": ["PASS", "FAIL", "SKIPPED", "DESELECTED"] },
    "retried": { "type": "boolean" },
    "counts": {
      "type": "object",
      "required": ["passed", "failed", "skipped", "pending"],
      "additionalProperties": false,
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "pending": { "type": "integer", "minimum": 0 }
      }
    },
    "exec_error": { "type": "boolean" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "failure_ref": { "type": ["string", "null"], "pattern": "^failures/[0-9a-f]{64}\\.txt$" },
    "clean": { "type": "boolean" },
    "tree_dirty": { "type": "boolean" },
    "tainted": { "type": "boolean" },
    "reason": { "type": ["string", "null"] },
    "verdict": { "type": "string", "pattern": "^[A-Z][A-Z_]*$" },
    "pid": { "type": "integer", "minimum": 1 },
    "pid_start": { "type": ["string", "null"] },
    "crc": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
  }
}
